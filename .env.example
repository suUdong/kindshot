# === Anthropic (paper 모드에서 필요) ===
ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_MAX_CONCURRENCY=2

# === KIS 한국투자증권 API (optional — 없으면 가격 조회 비활성) ===
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_IS_PAPER=true

# === Feed ===
# FEED_SOURCE=KIS          # KIS (AWS compatible) or KIND (local, KRX access 필요)
# FEED_INTERVAL_MARKET=3.0 # 장중 폴링 간격 (초)
# FEED_INTERVAL_OFF=15.0   # 장외 폴링 간격 (초)
# FEED_OVERLAP_S=90

# === Quant 필터 ===
# ADV_THRESHOLD=500000000       # 20일 평균 거래대금 최소 (원)
# POS_STRONG_ADV_THRESHOLD=2000000000  # 강한 촉매(POS_STRONG)에만 적용하는 완화 ADV 하한
# SPREAD_CHECK_ENABLED=true
# SPREAD_MISSING_POLICY=pass    # pass=fail-open, fail=fail-close
# CHASE_BUY_PCT=3.0             # 당일 상승률 이상이면 BUY 차단
# MIN_BUY_CONFIDENCE=72         # BUY 최소 confidence

# === 매매 타이밍 ===
# NO_BUY_AFTER_KST_HOUR=15     # 15:00 이후 BUY 차단
# NO_BUY_AFTER_KST_MINUTE=0

# === Paper Trading TP/SL ===
# PAPER_TAKE_PROFIT_PCT=1.5
# PAPER_STOP_LOSS_PCT=-1.0

# === Trailing Stop ===
# TRAILING_STOP_ENABLED=true
# TRAILING_STOP_PCT=0.8           # peak 대비 하락폭 (%)
# TRAILING_STOP_ACTIVATION_PCT=0.8 # 활성화 최소 수익률 (%)
# MAX_HOLD_MINUTES=30             # 최대 보유 시간 (0=비활성)

# === 포트폴리오 리스크 ===
# DAILY_LOSS_LIMIT=3000000  # 일일 손실 한도 (원)
# MAX_POSITIONS=4           # 1..5 범위만 허용, 더 큰 값은 repo config 기본값으로 대체
# MAX_SECTOR_POSITIONS=2
# ORDER_SIZE=5000000        # 기본 주문 크기 (원, M size)
# ORDER_SIZE_L=7000000      # L size (high confidence)
# ORDER_SIZE_S=3000000      # S size (low confidence)
# MICRO_LIVE_MAX_ORDER_WON=1000000  # micro-live 1건 주문 상한 (원)

# === Market ===
# KOSPI_HALT_PCT=-8.0
# MIN_MARKET_BREADTH_RATIO=0.3

# === Health 서버 ===
# HEALTH_HOST=127.0.0.1  # Docker에서는 0.0.0.0
# HEALTH_PORT=8080

# === UNKNOWN 리뷰 ===
# UNKNOWN_SHADOW_REVIEW_ENABLED=true
# UNKNOWN_PAPER_PROMOTION_ENABLED=true
# UNKNOWN_PROMOTION_MIN_CONFIDENCE=85

# === Pipeline ===
# PIPELINE_WORKERS=4
# PIPELINE_QUEUE_MAXSIZE=512

# === 캐시 ===
# PYKRX_CACHE_TTL_S=300
# PYKRX_CACHE_MAX_SIZE=512

# === Telegram 알림 ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 경로 ===
# LOG_DIR=logs
# DATA_DIR=data

# === v85.1 Stagnation Exit (default 활성, 14건 시뮬 +0.064 pp) ===
# STAGNATION_EXIT_ENABLED=true
# STAGNATION_EXIT_MAX_PEAK_PCT=0.05      # peak ≤ 0.05% 이면 정체로 판정
# STAGNATION_EXIT_MIN_MINUTES=15         # t+15m 이후부터 적용

# === RebalanceFeed (Topic 2, KOSPI200/KOSDAQ150 6·12월 rebalance window) ===
# REBALANCE_FEED_ENABLED=true            # default True

# === VolumeBreakoutFeed (v86, LLM-free 거래량 폭증 + N-day high 돌파) ===
# VOLUME_BREAKOUT_FEED_ENABLED=false             # 기본 false. 활성화 시 tickers 필요
# VOLUME_BREAKOUT_FEED_TICKERS=005930,000660     # CSV 종목 코드
# VOLUME_BREAKOUT_FEED_LOOKBACK_N=20             # N-day high 윈도우
# VOLUME_BREAKOUT_FEED_MIN_VOL_RATIO=2.0         # vol_today / prior_avg_vol_N 최소
# VOLUME_BREAKOUT_FEED_MIN_RET_TODAY=0.0         # 진입 시 당일 수익률 최소 %
# VOLUME_BREAKOUT_FEED_MAX_RET_TODAY=7.0         # 추격매수 방지 상한 %
# VOLUME_BREAKOUT_FEED_MIN_ADV_VALUE=500000000   # 20일 평균 거래대금 최소 (원)
# VOLUME_BREAKOUT_FEED_POLL_INTERVAL_S=3600      # 폴링 간격 (초)
# VOLUME_BREAKOUT_FEED_SIGNAL_COOLDOWN_S=86400   # 종목별 cooldown (초, 기본 24h)

# === AlphaFeed (Topic 3, alpha-scanner serve-kindshot-api 소비) ===
# ALPHA_FEED_ENABLED=false               # 기본 false. 활성화 시 base_url 필요
# ALPHA_SCANNER_API_BASE_URL=http://127.0.0.1:8765
# ALPHA_FEED_POLL_INTERVAL_S=300
# ALPHA_FEED_MIN_CONFIDENCE=78
# ALPHA_FEED_LIMIT=20

# === Y2iFeed (Topic 1, y2i scheduler kindshot_feed.json 소비) ===
# Y2I_FEED_ENABLED=false
# Y2I_SIGNAL_PATH=~/workspace/y2i/.omx/state/kindshot_feed.json
# Y2I_MIN_SCORE=55
# Y2I_MIN_VERDICT=WATCH
# Y2I_POLL_INTERVAL_S=60
# Y2I_LOOKBACK_DAYS=3

# === DART PEAD Phase 1 (잠정실적 earnings_queue 라우팅) ===
# DART_API_KEY=                          # 40자 토큰. 시크릿이므로 .env에만 보관
# DART_EARNINGS_ENABLED=true             # default True

# === Macro Filter (macro-intelligence FastAPI 소비) ===
# MACRO_FILTER_ENABLED=true              # default True
# MACRO_API_BASE_URL=http://127.0.0.1:8000
# MACRO_API_TIMEOUT_S=5.0

# === NVIDIA fallback (optional, Anthropic credit 절약용) ===
# NVIDIA_API_KEY=
